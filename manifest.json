{
  "manifest_version": 3,
  "name": "LinguaportaFuck",
  "version": "1.0.13",
  "description": "Linguaporta exercise helper using local Whisper, OpenAI, OpenRouter, Gemini, and custom OpenAI-compatible LLM APIs.",
  "permissions": ["activeTab", "scripting", "storage", "offscreen", "unlimitedStorage"],
  "host_permissions": [
    "https://api.openai.com/*",
    "https://openrouter.ai/*",
    "https://generativelanguage.googleapis.com/*",
    "https://huggingface.co/*",
    "https://*.huggingface.co/*",
    "https://*.hf.co/*",
    "https://*.xethub.hf.co/*",
    "https://*.linguaporta.jp/*",
    "http://*.linguaporta.jp/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "LinguaportaFuck Settings"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src 'self' https: http:; worker-src 'self'"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*.linguaporta.jp/user/seibido/*",
        "https://*.linguaporta.jp/user/seibido/*"
      ],
      "js": ["content.js"]
    }
  ],
  "icons": {
    "48": "icon.png"
  }
}
